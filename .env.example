# Copy this file to .env and fill in your actual API key(s).
# The app checks both variables — you only need to set one.

# Used by LangChain integrations (langchain-google-genai)
GOOGLE_API_KEY=your_google_api_key_here

# Used by the google-genai SDK directly (vision_extractor.py)
GEMINI_API_KEY=your_gemini_api_key_here
