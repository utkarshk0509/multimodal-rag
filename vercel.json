{
  "version": 2,
  "builds": [
    {
      "src": "backend_server.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["static/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend_server.py"
    }
  ],
  "functions": {
    "backend_server.py": {
      "maxDuration": 60
    }
  }
}

